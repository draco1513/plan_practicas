# Copia como ".env" si necesitas cambiar algo. Todo es opcional.

# URL base del backend. Déjalo vacío para usar el proxy de Vite (/api -> localhost:8085)
# o el proxy de nginx en Docker. Ejemplo sin proxy: http://localhost:8085
VITE_API_URL=

# Solo desarrollo: a dónde redirige Vite las llamadas /api
VITE_PROXY_TARGET=http://localhost:8085
