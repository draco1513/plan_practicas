# Copia este archivo como ".env" y cambia los valores.
# El archivo ".env" NO se sube al repositorio (está en .gitignore).

# --- PostgreSQL (puerto distinto al 5432) ---
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=cambia_esta_clave
DB_PORT=5433

# --- Redis ---
REDIS_PASSWORD=cambia_esta_clave_redis
REDIS_PORT=6380

# --- Backend (Spring Boot lee estas variables) ---
JWT_SECRET=cambia_este_secreto_largo_de_al_menos_32_caracteres
JWT_EXPIRATION_SECONDS=3600
APP_ADMIN_EMAIL=admin@esfx.local
APP_ADMIN_PASSWORD=cambia_esta_clave_admin

# --- Correo (SMTP). Si MAIL_HOST queda vacío, los correos solo se escriben en el log (modo desarrollo).
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=tucuenta@gmail.com, MAIL_PASSWORD=<contraseña de aplicación de 16 caracteres>
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Google (se completa cuando se configure el envío de correos y la sincronización) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Opcionales
SERVER_PORT=8085
# FLYWAY_DEV_LOCATION=,classpath:db/dev   # descomenta para cargar datos de prueba (solo desarrollo)
